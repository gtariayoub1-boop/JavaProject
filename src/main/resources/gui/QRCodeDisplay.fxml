<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox alignment="CENTER" spacing="20.0" styleClass="auth-hero-panel" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets>
        <URL value="@../style.css" />
    </stylesheets>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label fx:id="lblEventTitle" text="QR Code de l'Événement" styleClass="auth-hero-title" />
    
    <StackPane style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 10;">
        <ImageView fx:id="imgQRCode" fitWidth="300" fitHeight="300" preserveRatio="true" />
    </StackPane>

    <Label text="Scannez pour plus de détails" styleClass="auth-hero-copy" />
    
    <Button fx:id="btnClose" text="Fermer" styleClass="danger-button" prefWidth="150" />
</VBox>
